<Window x:Class="BrirPlayer.Next.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BrirPlayer Next"
        Width="1280"
        Height="900"
        MinWidth="1100"
        MinHeight="820"
        Background="#F4F1EB"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F6F3EE" Offset="0" />
            <GradientStop Color="#F0ECE3" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Padding" Value="28" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FCFBF7" Offset="0" />
                        <GradientStop Color="#F8F5EE" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#14000000" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DarkCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="26" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#171717" Offset="0" />
                        <GradientStop Color="#111111" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6D6D6D" />
        </Style>
        <Style x:Key="DarkEyebrowText" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="Foreground" Value="#AFAFAF" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Background" Value="#F5F2EB" />
            <Setter Property="BorderBrush" Value="#F5F2EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#12000000" />
            <Setter Property="BorderBrush" Value="#15000000" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>
        <Style x:Key="DarkActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="#F5F2EB" />
        </Style>
        <Style x:Key="ModeChipButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="#0BFFFFFF" />
            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#CFCFCF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#2CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F2EB" />
            <Setter Property="Background" Value="#0EFFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border CornerRadius="20"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}" />
                                        <Path Grid.Column="1"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Fill="#EDEAE3"
                                              Data="M 0 0 L 5 5 L 10 0 Z" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,8,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        CornerRadius="20"
                                        Background="#1C1C1C"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F5F2EB" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="14">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#343434" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F2EB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchBorder"
                                Padding="14,13"
                                CornerRadius="18"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1"
                                Background="#0BFFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <Grid Grid.Column="1" Width="42" Height="24" Margin="14,0,0,0">
                                    <Border x:Name="SwitchTrack" CornerRadius="12" Background="#22FFFFFF" />
                                    <Ellipse x:Name="SwitchKnob"
                                             Width="18"
                                             Height="18"
                                             Margin="3,3,0,3"
                                             HorizontalAlignment="Left"
                                             Fill="#FFFFFF" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#D9FFF1" />
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchKnob" Property="Margin" Value="0,3,3,3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#FFFFFF"
                                CornerRadius="9"
                                BorderBrush="#14000000"
                                BorderThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6"
                                    VerticalAlignment="Center"
                                    CornerRadius="999"
                                    Background="#14000000" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" BorderThickness="0" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        Height="6"
                                                        CornerRadius="999" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        Height="6"
                                                        CornerRadius="999" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSlider" TargetType="Slider" BasedOn="{StaticResource ModernSlider}">
            <Setter Property="Foreground" Value="#F5F2EB" />
        </Style>
        <Style x:Key="SeatButton" TargetType="Button">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#18000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SeatBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SeatBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresetCardButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="#15000000" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PresetBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetBorder" Property="Opacity" Value="0.94" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#14000000"
                                CornerRadius="999"
                                Height="{TemplateBinding Height}">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="999">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#111111" Offset="0" />
                                            <GradientStop Color="#6F6F6F" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  Background="{StaticResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="2,0,0,0">
                        <TextBlock Text="BrirPlayer Next" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Native bridge, web UI."
                                   Margin="0,12,0,0"
                                   MaxWidth="560"
                                   FontSize="52"
                                   FontWeight="SemiBold"
                                   Foreground="#111111"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="The desktop shell now carries the same white-and-black language as the web prototype, while still talking directly to Windows audio devices."
                                   Margin="0,18,0,0"
                                   MaxWidth="700"
                                   TextWrapping="Wrap"
                                   Foreground="#666666"
                                   FontSize="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   LineHeight="28" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Session" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="{Binding SessionBadge}" Margin="0,10,0,0" FontSize="19" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,12,0,0" Background="#111111" BorderBrush="#111111">
                            <StackPanel>
                                <TextBlock Text="Mode" Style="{StaticResource DarkEyebrowText}" />
                                <TextBlock Text="{Binding SelectedInputMode}" Margin="0,10,0,0" FontSize="19" FontWeight="SemiBold" Foreground="#F5F2EB" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Output" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="{Binding SelectedOutputDevice.Name}" Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,18,0" Style="{StaticResource DarkCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Routing" Style="{StaticResource DarkEyebrowText}" />
                        <TextBlock Text="Build the listening path first." Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" Foreground="#F5F2EB" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding InputModeChips}" Margin="0,22,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Click="ModeButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ModeChipButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#F5F2EB" />
                                                        <Setter Property="BorderBrush" Value="#F5F2EB" />
                                                        <Setter Property="Foreground" Value="#111111" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Input" Margin="0,18,0,0" Style="{StaticResource DarkEyebrowText}" />
                        <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,8,0,0" Style="{StaticResource DarkComboBox}" />
                        <TextBlock Text="{Binding SelectedInputDevice.Details}" Margin="4,6,0,0" Foreground="#9F9F9F" TextWrapping="Wrap" />
                        <TextBlock Text="Output" Margin="0,18,0,0" Style="{StaticResource DarkEyebrowText}" />
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0,8,0,0" Style="{StaticResource DarkComboBox}" />
                        <TextBlock Text="{Binding SelectedOutputDevice.Details}" Margin="4,6,0,0" Foreground="#9F9F9F" TextWrapping="Wrap" />
                        <CheckBox Content="Exclusive Output" IsChecked="{Binding ExclusiveOutput, Mode=TwoWay}" Margin="0,18,0,0" Style="{StaticResource SwitchCheckBox}" />
                        <CheckBox Content="Volume Match" IsChecked="{Binding VolumeMatch, Mode=TwoWay}" Margin="0,10,0,0" Style="{StaticResource SwitchCheckBox}" />
                        <Border Margin="0,18,0,0" Padding="16" CornerRadius="20" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Output Volume" Style="{StaticResource DarkEyebrowText}" />
                                    <TextBlock Text="{Binding OutputVolume, StringFormat={}{0:P0}}" DockPanel.Dock="Right" Foreground="#F5F2EB" FontWeight="SemiBold" />
                                </DockPanel>
                                <Slider Value="{Binding OutputVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Margin="0,12,0,0" Style="{StaticResource DarkSlider}" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" IsEnabled="{Binding CanStartLive}" Click="StartStopButton_Click" />
                            <Button Grid.Column="1" Content="Convert File" Style="{StaticResource DarkActionButton}" Click="ConvertFileButton_Click" />
                        </Grid>
                        <Button Content="Refresh Devices" Style="{StaticResource DarkActionButton}" Margin="0,10,0,0" Click="RefreshDevicesButton_Click" />
                        <Border Margin="0,22,0,0" Padding="0,18,0,0" Background="Transparent" BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Border Background="Transparent" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="999" Padding="10,6">
                                        <TextBlock Text="{Binding SelectedInputMode}" Style="{StaticResource DarkEyebrowText}" />
                                    </Border>
                                    <TextBlock Text="Current path" DockPanel.Dock="Right" Style="{StaticResource DarkEyebrowText}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="01" Foreground="#F5F2EB" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Source" Foreground="#F5F2EB" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedInputDevice.Name}" Margin="0,4,0,0" Foreground="#ABABAB" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="02" Foreground="#F5F2EB" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Processing" Foreground="#F5F2EB" FontWeight="SemiBold" />
                                        <TextBlock Text="Resample, BRIR, limiter, telemetry" Margin="0,4,0,0" Foreground="#ABABAB" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#26FFFFFF" BorderThickness="1" HorizontalAlignment="Left">
                                        <TextBlock Text="03" Foreground="#F5F2EB" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Destination" Foreground="#F5F2EB" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedOutputDevice.Name}" Margin="0,4,0,0" Foreground="#ABABAB" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,18,0,0" Padding="16" CornerRadius="20" Background="#0BFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding SessionState}" Foreground="#F5F2EB" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedModeDescription}" Margin="0,8,0,0" Foreground="#B4B4B4" TextWrapping="Wrap" LineHeight="22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,24,0" CornerRadius="28" Background="{Binding SelectedPresetBrush}">
                                <Grid>
                                    <Ellipse Width="164" Height="164" Fill="#66FFFFFF" Opacity="0.22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" />
                                    <Ellipse Width="112" Height="112" Fill="#D7D7D7" Opacity="0.42" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Selected space" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="{Binding SelectedPresetName}" Margin="0,10,0,0" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedPresetSummary}" Margin="0,16,0,0" Foreground="#666666" TextWrapping="Wrap" LineHeight="28" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Margin="0,0,0,12" Padding="18" CornerRadius="22" Background="#111111"><StackPanel><TextBlock Text="Seat" Style="{StaticResource DarkEyebrowText}" /><TextBlock Text="{Binding SeatLabel}" Margin="0,10,0,0" Foreground="#F5F2EB" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Margin="0,0,0,12" Padding="18" CornerRadius="22" Background="#111111"><StackPanel><TextBlock Text="Profile" Style="{StaticResource DarkEyebrowText}" /><TextBlock Text="{Binding SelectedPresetProfile}" Margin="0,10,0,0" Foreground="#F5F2EB" FontSize="18" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Padding="18" CornerRadius="22" Background="#111111"><StackPanel><TextBlock Text="Output" Style="{StaticResource DarkEyebrowText}" /><TextBlock Text="{Binding SelectedOutputDevice.Name}" Margin="0,10,0,0" Foreground="#F5F2EB" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,20,0,0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Seat field" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="Move the listening point like it belongs to the room." Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" />
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Border Margin="0,0,8,0" Padding="12,7" CornerRadius="999" BorderBrush="#14000000" BorderThickness="1">
                                        <TextBlock Text="Grid 5x5" Style="{StaticResource EyebrowText}" />
                                    </Border>
                                    <Border Padding="12,7" CornerRadius="999" BorderBrush="#14000000" BorderThickness="1">
                                        <TextBlock Text="{Binding SeatLabel}" Style="{StaticResource EyebrowText}" />
                                    </Border>
                                </WrapPanel>
                            </DockPanel>
                            <Border Margin="0,22,0,0" Padding="24" CornerRadius="28" Background="#FCFBF8" BorderBrush="#14000000" BorderThickness="1">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding SeatNodes}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><primitives:UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Click="SeatButton_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SeatButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#111111" />
                                                                    <Setter Property="BorderBrush" Value="#111111" />
                                                                    <Setter Property="Foreground" Value="#F5F2EB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Seat X" FontSize="13" Foreground="#666666" /><Slider Value="{Binding SeatX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Margin="0,12,0,0" Style="{StaticResource ModernSlider}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Seat Y" FontSize="13" Foreground="#666666" /><Slider Value="{Binding SeatY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Margin="0,12,0,0" Style="{StaticResource ModernSlider}" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Keep rooms scannable, not buried in file paths." Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding SpacePresets}" Margin="0,22,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="PresetButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PresetCardButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#111111" />
                                                            <Setter Property="BorderBrush" Value="#111111" />
                                                            <Setter Property="Foreground" Value="#F5F2EB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Profile}" Margin="0,8,0,0" Opacity="0.76" />
                                                <TextBlock Text="{Binding Summary}" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.80" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Telemetry" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Always visible health." Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding MetricTiles}" Margin="0,20,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,18">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="#666666" />
                                                <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Fill}" Maximum="1" Margin="0,8,0,0" Style="{StaticResource MetricProgressBar}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,18,0,0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Session" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Working state" Margin="0,10,0,0" FontSize="29" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,20,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
