<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <WebUiProjectDir>..\BrirPlayer.Next.WebUI</WebUiProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrirSpatializer.Audio\BrirSpatializer.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

  <Target Name="BuildWebUi" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build" WorkingDirectory="$(WebUiProjectDir)" />
  </Target>

  <Target Name="CopyWebUiAssets" AfterTargets="Build">
    <ItemGroup>
      <WebUiDistFiles Include="$(WebUiProjectDir)\dist\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(WebUiDistFiles)"
          DestinationFiles="@(WebUiDistFiles->'$(OutDir)WebUI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
